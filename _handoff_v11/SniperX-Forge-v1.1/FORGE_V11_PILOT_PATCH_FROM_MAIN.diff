diff --git a/forge-cloud/src/stripe_test.mjs b/forge-cloud/src/stripe_test.mjs
new file mode 100644
index 0000000..3b3fff1
--- /dev/null
+++ b/forge-cloud/src/stripe_test.mjs
@@ -0,0 +1,167 @@
+/**
+ * Stripe Checkout TEST-MODE ONLY integration for Forge pilot development.
+ * No live charges, worker payouts, Stripe Connect transfers, or wage payments.
+ * Test checkout events are segregated from the simulated worker wallet.
+ * NEVER add automatic wallet credits on the strength of these events.
+ */
+import {createHmac, timingSafeEqual} from 'node:crypto';
+import {fail} from './security.mjs';
+
+const NOW=()=>new Date().toISOString();
+const TEST_API='https://api.stripe.com';
+const SUPPORTED_EVENTS=new Set(['checkout.session.completed','checkout.session.expired','checkout.session.async_payment_succeeded']);
+const stripeError=(message)=>Object.assign(new Error(message),{status:503});
+const role=(ctx,...roles)=>{if(!ctx.user)fail(401,'Authentication required');if(!roles.includes(ctx.user.role))fail(403,'Access denied');};
+
+export function stripeTestConfigured(key){return typeof key==='string'&&key.startsWith('sk_test_')&&key.length>8;}
+
+/** Client constructor refuses ALL live-mode secret keys and untrusted API endpoints. */
+export function makeStripeTestClient({secretKey,fetchImpl=fetch,apiBase=TEST_API}={}){
+  if(!stripeTestConfigured(secretKey))throw new Error('Only sk_test_ keys are accepted for Forge checkout test mode');
+  if(apiBase!==TEST_API)throw new Error('Stripe API endpoint must be official');
+  return {
+    async createSession({mission,origin}){
+      const url=new URL(origin);
+      if(!['http:','https:'].includes(url.protocol)||url.pathname!=='/'||url.search||url.hash)throw new Error('Invalid Forge origin');
+      const form=new URLSearchParams({
+        mode:'payment',
+        'payment_method_types[0]':'card',
+        'line_items[0][price_data][currency]':'usd',
+        'line_items[0][price_data][unit_amount]':String(mission.priceCents),
+        'line_items[0][price_data][product_data][name]':`Forge TEST mission: ${mission.title.slice(0,100)}`,
+        'line_items[0][quantity]':'1',
+        'metadata[forge_test_mission_id]':mission.id,
+        'client_reference_id':mission.id,
+        success_url:`${origin.replace(/\/$/,'')}/?stripe_test=success&session_id={CHECKOUT_SESSION_ID}`,
+        cancel_url:`${origin.replace(/\/$/,'')}/?stripe_test=cancel`,
+      });
+      const res=await fetchImpl(`${TEST_API}/v1/checkout/sessions`,{
+        method:'POST',
+        headers:{Authorization:`Bearer ${secretKey}`,'Content-Type':'application/x-www-form-urlencoded','Idempotency-Key':`forge-test-checkout-${mission.id}`},
+        body:form.toString(),
+        signal:AbortSignal.timeout(12000)
+      });
+      let payload;try{payload=await res.json()}catch{throw stripeError('Stripe test API returned unreadable response')}
+      if(!res.ok)throw stripeError('Stripe test API request was unsuccessful');
+      if(!payload||payload.livemode!==false||typeof payload.id!=='string'||!payload.id.startsWith('cs_test_')||
+        typeof payload.url!=='string'||!payload.url.startsWith('https://checkout.stripe.com/')){
+        throw stripeError('Stripe did not return a valid TEST Checkout Session');
+      }
+      if(payload.amount_total!==undefined && payload.amount_total!==mission.priceCents)throw stripeError('Stripe test session amount mismatch');
+      if(payload.currency!==undefined && payload.currency!=='usd')throw stripeError('Stripe test session currency mismatch');
+      return {id:payload.id,url:payload.url,livemode:false};
+    }
+  };
+}
+
+/** Stripe-signature validation uses the EXACT raw body; protects against tampering and replay. */
+export function verifyStripeTestEvent(raw,signatureHeader,webhookSecret,{currentSeconds=Math.floor(Date.now()/1000)}={}){
+  if(typeof webhookSecret!=='string'||!webhookSecret.startsWith('whsec_')||webhookSecret.length<=6)fail(503,'Stripe test webhook is not configured');
+  if(!Buffer.isBuffer(raw)||raw.length===0||raw.length>65536)fail(400,'Invalid webhook payload');
+  if(typeof signatureHeader!=='string'||signatureHeader.length>2000)fail(400,'Missing valid webhook signature');
+  const parts=signatureHeader.split(',').map(p=>p.trim().split('='));
+  const timestamp=parts.find(p=>p[0]==='t')?.[1];
+  const sigs=parts.filter(p=>p[0]==='v1').map(p=>p[1]);
+  if(!/^\d{10}$/.test(timestamp||'')||Math.abs(currentSeconds-Number(timestamp))>300)fail(400,'Webhook timestamp outside accepted window');
+  const expected=createHmac('sha256',webhookSecret).update(`${timestamp}.`).update(raw).digest();
+  const valid=sigs.some(sig=>{
+    if(typeof sig!=='string'||! /^[0-9a-f]{64}$/i.test(sig))return false;
+    return timingSafeEqual(expected,Buffer.from(sig,'hex'));
+  });
+  if(!valid)fail(400,'Invalid Stripe webhook signature');
+  let event;try{event=JSON.parse(raw.toString('utf8'))}catch{fail(400,'Invalid JSON webhook')}
+  if(!event||typeof event!=='object'||Array.isArray(event)||typeof event.id!=='string'||!/^evt_[a-zA-Z0-9_]{3,150}$/.test(event.id))fail(400,'Invalid Stripe event');
+  if(event.livemode!==false)fail(400,'Live Stripe events are prohibited in test mode');
+  return event;
+}
+
+/** Incoming TEST events are idempotent. They do not fund missions or wallet balances. */
+export function applyStripeTestEvent(store,event){
+  return store.transaction(()=>{
+    const prior=store.one('SELECT id FROM stripe_test_webhook_events WHERE id=?',event.id);
+    if(prior)return {received:true,duplicate:true,mode:'TEST_ONLY'};
+    const type=typeof event.type==='string'?event.type.slice(0,100):'unknown';
+    const session=event.data?.object;
+    let accepted=false,reason='EVENT_NOT_APPLICABLE';
+    if(SUPPORTED_EVENTS.has(type)&&session&&typeof session==='object'&&session.livemode===false&&
+        typeof session.id==='string'&&session.id.startsWith('cs_test_')){
+      const stored=store.one('SELECT * FROM stripe_test_checkout_sessions WHERE session_id=?',session.id);
+      if(stored && session.metadata?.forge_test_mission_id===stored.mission_id && session.client_reference_id===stored.mission_id &&
+          session.currency==='usd' && session.amount_total===stored.amount_cents){
+        if(type==='checkout.session.expired'){
+          if(stored.status==='OPEN_TEST'){
+            store.run('UPDATE stripe_test_checkout_sessions SET status=?,updated_at=? WHERE mission_id=?','EXPIRED_TEST',NOW(),stored.mission_id);
+            accepted=true;reason='SESSION_EXPIRED_TEST';
+          }else reason='STATUS_NOT_APPLICABLE';
+        }else if(session.payment_status==='paid'){
+          if(stored.status==='OPEN_TEST'){
+            store.run('UPDATE stripe_test_checkout_sessions SET status=?,updated_at=? WHERE mission_id=?','PAID_TEST',NOW(),stored.mission_id);
+            accepted=true;reason='TEST_PAYMENT_CONFIRMED_NO_WALLET_CREDIT';
+          }else reason='STATUS_NOT_APPLICABLE';
+        }else reason='NOT_PAID';
+      }else reason='SESSION_NOT_MATCHED';
+    }
+    store.run('INSERT INTO stripe_test_webhook_events(id,event_type,accepted,reason,received_at) VALUES(?,?,?,?,?)',event.id,type,accepted?1:0,reason,NOW());
+    // Don't let untrusted webhook events cause financial ledger writes.
+    store.audit(null,'STRIPE_TEST_WEBHOOK','stripe_test_event',event.id,{type,accepted,reason});
+    return {received:true,duplicate:false,accepted,mode:'TEST_ONLY'};
+  });
+}
+
+export async function handleStripeTest(ctx){
+  const {store,method,path,publicOrigin,stripeTestClient}=ctx;
+  const start=path.match(/^\/api\/missions\/([^/]+)\/test-checkout$/);
+  if(method==='POST'&&start){
+    role(ctx,'buyer');
+    if(!stripeTestClient)fail(503,'Stripe Checkout test mode is not configured');
+    const mission=store.getMission(start[1]);
+    if(!mission||mission.buyerUserId!==ctx.user.id)fail(404,'Mission not found');
+    if(mission.safetyHold||!['NEW','APPROVED'].includes(mission.status))fail(409,'Mission not eligible for test checkout');
+    if(!Number.isSafeInteger(mission.priceCents)||mission.priceCents<100||mission.priceCents>1_000_000)fail(409,'Invalid mission price');
+    const existing=store.transaction(()=>{
+      const old=store.one('SELECT * FROM stripe_test_checkout_sessions WHERE mission_id=?',mission.id);
+      if(old){
+        if(old.status==='CREATE_FAILED_TEST' || old.status==='CREATING_TEST' && Date.now()-Date.parse(old.updated_at)>60000){
+          store.run('UPDATE stripe_test_checkout_sessions SET status=?,updated_at=? WHERE mission_id=?','CREATING_TEST',NOW(),mission.id);
+          return null;
+        }
+        return old;
+      }
+      store.run('INSERT INTO stripe_test_checkout_sessions(mission_id,session_id,checkout_url,amount_cents,status,created_at,updated_at) VALUES(?,?,?,?,?,?,?)',mission.id,null,null,mission.priceCents,'CREATING_TEST',NOW(),NOW());
+      return null;
+    });
+    if(existing){
+      if(existing.status==='OPEN_TEST' && existing.checkout_url)return {
+        mode:'STRIPE_TEST_ONLY',url:existing.checkout_url,sessionId:existing.session_id,amountCents:existing.amount_cents,
+        duplicate:true,realPaymentCollected:false,workerPayoutEnabled:false
+      };
+      fail(409,`Existing test checkout status: ${existing.status}`);
+    }
+    try{
+      const session=await stripeTestClient.createSession({mission,origin:publicOrigin});
+      store.transaction(()=>{
+        store.run('UPDATE stripe_test_checkout_sessions SET session_id=?,checkout_url=?,status=?,updated_at=? WHERE mission_id=?',session.id,session.url,'OPEN_TEST',NOW(),mission.id);
+        store.audit(ctx.user.id,'STRIPE_TEST_CHECKOUT_CREATED','mission',mission.id,{sessionId:session.id,amountCents:mission.priceCents,live:false});
+      });
+      return {mode:'STRIPE_TEST_ONLY',url:session.url,sessionId:session.id,amountCents:mission.priceCents,realPaymentCollected:false,workerPayoutEnabled:false};
+    }catch(error){
+      store.transaction(()=>store.run('UPDATE stripe_test_checkout_sessions SET status=?,updated_at=? WHERE mission_id=? AND status=?','CREATE_FAILED_TEST',NOW(),mission.id,'CREATING_TEST'));
+      throw error;
+    }
+  }
+  const status=path.match(/^\/api\/missions\/([^/]+)\/test-checkout\/status$/);
+  if(method==='GET'&&status){
+    role(ctx,'buyer','admin');
+    const mission=store.getMission(status[1]);
+    if(!mission||ctx.user.role!=='admin'&&mission.buyerUserId!==ctx.user.id)fail(404,'Mission not found');
+    const record=store.one('SELECT session_id,status,amount_cents,updated_at FROM stripe_test_checkout_sessions WHERE mission_id=?',mission.id);
+    return {mode:'TEST_ONLY',checkout:record||null,realFundsCollected:false,workerPayoutEnabled:false};
+  }
+  if(method==='GET'&&path==='/api/admin/stripe-test/summary'){
+    role(ctx,'admin');
+    const counts=store.all('SELECT status,COUNT(*) AS count FROM stripe_test_checkout_sessions GROUP BY status');
+    const webhooks=store.one('SELECT COUNT(*) AS received,COALESCE(SUM(accepted),0) AS accepted FROM stripe_test_webhook_events');
+    return {configured:!!stripeTestClient,liveMode:false,workerBankPayoutsEnabled:false,checkoutCounts:counts,webhooks};
+  }
+  return undefined;
+}
diff --git a/forge-cloud/tests/reconcile.test.mjs b/forge-cloud/tests/reconcile.test.mjs
new file mode 100644
index 0000000..6f855b0
--- /dev/null
+++ b/forge-cloud/tests/reconcile.test.mjs
@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import os from 'node:os';
+import fs from 'node:fs';
+import path from 'node:path';
+import {randomUUID} from 'node:crypto';
+import {openStore} from '../src/db.mjs';
+import {auditSandboxLedger,launchReadiness} from '../src/reconcile.mjs';
+import {splitPayment} from '../src/core.mjs';
+
+const dir=fs.mkdtempSync(path.join(os.tmpdir(),'forge-reconcile-test-'));
+const store=openStore(path.join(dir,'test.sqlite'));
+const uid=randomUUID(), buyer=randomUUID(), missionId=randomUUID();
+const date=new Date().toISOString();
+store.run('INSERT INTO users VALUES(?,?,?,?,?,?)',uid,'worker@example.invalid','x','worker','Worker',date);
+store.run('INSERT INTO users VALUES(?,?,?,?,?,?)',buyer,'buyer@example.invalid','x','buyer','Buyer',date);
+const mission={id:missionId,status:'COMPLETED',buyerAccepted:true,workerUserId:uid,priceCents:10000,safetyHold:false};
+store.run('INSERT INTO missions VALUES(?,?,?,?,?,?)',missionId,buyer,uid,JSON.stringify(mission),date,date);
+const split=splitPayment(10000);
+store.run('INSERT INTO sandbox_mission_funding VALUES(?,?,?,?,?,?,?,?)',missionId,10000,split.workerPayCents,split.platformFeeCents,'RELEASED',buyer,date,date);
+store.run('INSERT INTO sandbox_wallet_ledger VALUES(?,?,?,?,?,?,?,?)',randomUUID(),uid,missionId,null,'MISSION_RELEASE',split.workerPayCents,'mission-release:'+missionId,date);
+try{
+  await test('a consistent funded completed mission reconciles but still has launch blockers',()=>{
+    const r=auditSandboxLedger(store);assert.equal(r.ok,true,JSON.stringify(r.issues));
+    const l=launchReadiness(store,{stripeTestConfigured:true});
+    assert.equal(l.stripeTestConfigured,true);assert.equal(l.publicLaunchAllowed,false);assert.equal(l.realPayoutsEnabled,false);
+    assert.ok(l.blockers.some(x=>x.id==='employment_law'));
+  });
+  await test('test checkout cannot become a worker balance',()=>{
+    store.run('INSERT INTO stripe_test_checkout_sessions VALUES(?,?,?,?,?,?,?)',missionId,'cs_test_example','https://checkout.stripe.com/c/pay/cs_test_example',10000,'PAID_TEST',date,date);
+    const r=auditSandboxLedger(store);
+    assert.equal(r.ok,true);assert.equal(r.counts.testCheckoutSessions,1);
+    assert.equal(store.one('SELECT COALESCE(SUM(amount_cents),0) AS cents FROM sandbox_wallet_ledger WHERE worker_user_id=?',uid).cents,split.workerPayCents);
+  });
+  await test('mismatched funding is flagged',()=>{
+    store.run('UPDATE sandbox_mission_funding SET worker_cents=worker_cents-1 WHERE mission_id=?',missionId);
+    const r=auditSandboxLedger(store);assert.equal(r.ok,false);
+    assert.ok(r.issues.some(x=>x.code==='INCORRECT_SPLIT'));
+    assert.ok(r.issues.some(x=>x.code==='MISSING_OR_WRONG_WORKER_CREDIT'));
+    store.run('UPDATE sandbox_mission_funding SET worker_cents=? WHERE mission_id=?',split.workerPayCents,missionId);
+  });
+  await test('double-credit and missing payout refund are flagged',()=>{
+    const duplicate=randomUUID();
+    store.run('INSERT INTO sandbox_wallet_ledger VALUES(?,?,?,?,?,?,?,?)',duplicate,uid,missionId,null,'MISSION_RELEASE',split.workerPayCents,'extra:'+duplicate,date);
+    assert.ok(auditSandboxLedger(store).issues.some(x=>x.code==='MISSING_OR_WRONG_WORKER_CREDIT'));
+    store.run('DELETE FROM sandbox_wallet_ledger WHERE id=?',duplicate);
+    const payoutId=randomUUID();
+    store.run('INSERT INTO sandbox_payouts VALUES(?,?,?,?,?,?,?,?,?,?)',payoutId,uid,'reconcile-refund-key-00001','STANDARD',1000,0,1000,'FAILED_SIMULATED',date,date);
+    store.run('INSERT INTO sandbox_wallet_ledger VALUES(?,?,?,?,?,?,?,?)',randomUUID(),uid,null,payoutId,'PAYOUT_RESERVED',-1000,'payout-reserve:'+payoutId,date);
+    const r=auditSandboxLedger(store);assert.equal(r.ok,false);
+    assert.ok(r.issues.some(x=>x.code==='FAILED_PAYOUT_NOT_RESTORED'));
+    const l=launchReadiness(store);assert.equal(l.publicLaunchAllowed,false);assert.ok(l.blockers.some(x=>x.id==='sandbox_integrity'));
+  });
+}finally{store.close();fs.rmSync(dir,{recursive:true,force:true})}
diff --git a/forge-cloud/tests/stripe-test.test.mjs b/forge-cloud/tests/stripe-test.test.mjs
new file mode 100644
index 0000000..42a94a0
--- /dev/null
+++ b/forge-cloud/tests/stripe-test.test.mjs
@@ -0,0 +1,164 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import {randomUUID,createHmac} from 'node:crypto';
+import {createForgeServer} from '../src/server.mjs';
+import {hashPassword} from '../src/security.mjs';
+import {makeStripeTestClient,verifyStripeTestEvent,applyStripeTestEvent} from '../src/stripe_test.mjs';
+
+const tmp=fs.mkdtempSync(path.join(os.tmpdir(),'forge-stripe-test-'));
+const password='extremely-secure-private-test-password';
+const webhookSecret='whsec_test_dummy_signature_signing_secret';
+const customerId=randomUUID();
+const fakeCheckoutID='cs_test_1234567890example';
+let checkoutCalls=0;
+let mockShouldFail=false;
+const fakeFetch=async (url,opts)=>{
+  checkoutCalls++;
+  assert.equal(url,'https://api.stripe.com/v1/checkout/sessions');
+  assert.match(opts.headers.Authorization,/^Bearer sk_test_/);
+  const parsed=new URLSearchParams(opts.body);
+  assert.equal(parsed.get('mode'),'payment');
+  assert.equal(parsed.get('payment_method_types[0]'),'card');
+  assert.equal(parsed.get('metadata[forge_test_mission_id]'),parsed.get('client_reference_id'));
+  assert.ok(parsed.get('success_url').includes('{CHECKOUT_SESSION_ID}'));
+  assert.equal(opts.headers['Idempotency-Key'],`forge-test-checkout-${parsed.get('client_reference_id')}`);
+  if(mockShouldFail)return {ok:false,json:async()=>({error:{message:'Simulated temporary failure'}})};
+  return {ok:true,json:async()=>({id:fakeCheckoutID,url:`https://checkout.stripe.com/c/pay/${fakeCheckoutID}`,livemode:false,currency:'usd',amount_total:9000})};
+};
+const client=makeStripeTestClient({secretKey:'sk_test_not_a_real_key',fetchImpl:fakeFetch});
+const app=createForgeServer({dbPath:path.join(tmp,'test.sqlite'),publicOrigin:'http://127.0.0.1:5200',stripeTestClient:client,stripeWebhookSecret:webhookSecret});
+const userId=randomUUID(),adminId=randomUUID();
+app.store.run('INSERT INTO users VALUES(?,?,?,?,?,?)',userId,'buyer@example.invalid',hashPassword(password),'buyer','Forge Test Buyer',new Date().toISOString());
+app.store.run('INSERT INTO users VALUES(?,?,?,?,?,?)',customerId,'worker@example.invalid',hashPassword(password),'worker','Forge Test Worker',new Date().toISOString());
+app.store.run('INSERT INTO users VALUES(?,?,?,?,?,?)',adminId,'admin@example.invalid',hashPassword(password),'admin','Forge Test Admin',new Date().toISOString());
+await new Promise(resolve=>app.server.listen(0,'127.0.0.1',resolve));
+const root=`http://127.0.0.1:${app.server.address().port}`;
+let buyer={};let missionId;
+async function api(url,{as,method='GET',data,headers={}}={}){
+  let h={...headers};if(as?.cookie)h.Cookie=as.cookie;
+  if(data!==undefined){h['Content-Type']='application/json';}
+  if(as?.csrf&&method==='POST'&&!('X-Forge-CSRF' in h))h['X-Forge-CSRF']=as.csrf;
+  const res=await fetch(root+'/api'+url,{method,headers:h,body:data===undefined?undefined:JSON.stringify(data)});
+  return {status:res.status,body:await res.json(),cookie:res.headers.get('set-cookie')};
+}
+function sign(raw,{timestamp=Math.floor(Date.now()/1000),secret=webhookSecret}={}){
+  const signature=createHmac('sha256',secret).update(`${timestamp}.`).update(raw).digest('hex');
+  return `t=${timestamp},v1=${signature}`;
+}
+async function webhook(event,{signature,raw}={}){
+  const payload=raw||JSON.stringify(event);
+  const res=await fetch(root+'/api/webhooks/stripe-test',{method:'POST',headers:{'Content-Type':'application/json','Stripe-Signature':signature||sign(payload)},body:payload});
+  return {status:res.status,body:await res.json()};
+}
+function event({id='evt_test_event_123456',type='checkout.session.completed',amount=9000,paid='paid',live=false,sessionId=fakeCheckoutID,mission=missionId}={}){
+  return {id,type,livemode:live,data:{object:{id:sessionId,object:'checkout.session',livemode:live,client_reference_id:mission,metadata:{forge_test_mission_id:mission},amount_total:amount,currency:'usd',payment_status:paid}}};
+}
+try{
+  await test('rejects all live-mode Stripe API keys and nonofficial endpoints',()=>{
+    assert.throws(()=>makeStripeTestClient({secretKey:'sk_live_DANGER'}),/Only sk_test_/);
+    assert.throws(()=>makeStripeTestClient({secretKey:'sk_test_valid',apiBase:'http://localhost:1'}),/official/);
+  });
+  await test('checks signature timestamp, signature and live-mode webhook bans',()=>{
+    const raw=Buffer.from(JSON.stringify(event({mission:'test-mission-id'})));
+    assert.equal(verifyStripeTestEvent(raw,sign(raw),webhookSecret).livemode,false);
+    assert.throws(()=>verifyStripeTestEvent(raw,sign(raw,{timestamp:Math.floor(Date.now()/1000)-1000}),webhookSecret),/timestamp/);
+    assert.throws(()=>verifyStripeTestEvent(Buffer.from('changed'),sign(raw),webhookSecret),/signature/);
+    const live=Buffer.from(JSON.stringify(event({mission:'test-mission-id',live:true})));
+    assert.throws(()=>verifyStripeTestEvent(live,sign(live),webhookSecret),/Live Stripe events/);
+  });
+  await test('buyer creates a test-only mission; unauthorized buyer cannot checkout',async()=>{
+    const login=await api('/auth/login',{method:'POST',data:{email:'buyer@example.invalid',password}});
+    assert.equal(login.status,200);buyer={cookie:login.cookie.split(';')[0],csrf:login.body.csrf};
+    const created=await api('/missions',{as:buyer,method:'POST',data:{title:'Proofread draft product descriptions',description:'Proofread twenty short product descriptions for clarity and typos only.',category:'Content & Copy',city:'Newark',schedule:'Flexible',skills:['Editing'],priceUSD:90}});
+    assert.equal(created.status,200,JSON.stringify(created.body));missionId=created.body.mission.id;
+    assert.equal((await api(`/missions/${missionId}/test-checkout`,{method:'POST',data:{}})).status,401);
+    assert.equal((await api(`/missions/${missionId}/test-checkout`,{as:buyer,method:'POST',data:{},headers:{'X-Forge-CSRF':'bad'}})).status,403);
+    assert.equal((await api('/admin/stripe-test/summary',{as:buyer})).status,403);
+  });
+  await test('test checkout fails closed, then safely retries with same Stripe idempotency key',async()=>{
+    mockShouldFail=true;
+    const bad=await api(`/missions/${missionId}/test-checkout`,{as:buyer,method:'POST',data:{}});
+    assert.equal(bad.status,503);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'CREATE_FAILED_TEST');
+    mockShouldFail=false;
+    const good=await api(`/missions/${missionId}/test-checkout`,{as:buyer,method:'POST',data:{}});
+    assert.equal(good.status,200,JSON.stringify(good.body));
+    assert.equal(good.body.mode,'STRIPE_TEST_ONLY');
+    assert.equal(good.body.realPaymentCollected,false);
+    assert.equal(good.body.workerPayoutEnabled,false);
+    assert.equal(good.body.amountCents,9000);
+    assert.ok(good.body.url.startsWith('https://checkout.stripe.com/'));
+    assert.equal(checkoutCalls,2);
+    const duplicate=await api(`/missions/${missionId}/test-checkout`,{as:buyer,method:'POST',data:{}});
+    assert.equal(duplicate.status,200);
+    assert.equal(duplicate.body.duplicate,true);
+    assert.equal(checkoutCalls,2);
+    const status=await api(`/missions/${missionId}/test-checkout/status`,{as:buyer});
+    assert.equal(status.status,200);
+    assert.equal(status.body.checkout.status,'OPEN_TEST');
+  });
+  await test('webhook authentication is mandatory; modified signatures fail',async()=>{
+    const evt=event();const raw=JSON.stringify(evt);
+    const bad=await webhook(evt,{signature:sign(raw,{secret:'whsec_wrong_secret'})});
+    assert.equal(bad.status,400);
+    const live=await webhook(event({live:true}));assert.equal(live.status,400);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'OPEN_TEST');
+  });
+  await test('paid webhook must match session ID, mission, currency, and amount',async()=>{
+    const invalid=await webhook(event({id:'evt_wrong_amount_456',amount:8999}));
+    assert.equal(invalid.status,200);
+    assert.equal(invalid.body.accepted,false);
+    const wrong=await webhook(event({id:'evt_wrong_id_456',sessionId:'cs_test_different'}));
+    assert.equal(wrong.status,200);
+    assert.equal(wrong.body.accepted,false);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'OPEN_TEST');
+    const unpaid=await webhook(event({id:'evt_not_paid_456',paid:'unpaid'}));
+    assert.equal(unpaid.body.accepted,false);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'OPEN_TEST');
+  });
+  await test('valid Stripe TEST webhook confirms test checkout, but never funds a worker',async()=>{
+    const evt=event();
+    const first=await webhook(evt);assert.equal(first.status,200,JSON.stringify(first.body));assert.equal(first.body.accepted,true);
+    const replay=await webhook(evt);assert.equal(replay.status,200);assert.equal(replay.body.duplicate,true);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'PAID_TEST');
+    assert.equal(app.store.one('SELECT COUNT(*) n FROM sandbox_wallet_ledger').n,0);
+    assert.equal(app.store.one('SELECT COUNT(*) n FROM sandbox_mission_funding').n,0);
+    const status=await api(`/missions/${missionId}/test-checkout/status`,{as:buyer});
+    assert.equal(status.body.realFundsCollected,false);assert.equal(status.body.workerPayoutEnabled,false);
+    const workerLogin=await api('/auth/login',{method:'POST',data:{email:'worker@example.invalid',password}});
+    assert.equal(workerLogin.status,200);
+    const worker={cookie:workerLogin.cookie.split(';')[0],csrf:workerLogin.body.csrf};
+    const wallet=await api('/wallet/me',{as:worker});assert.equal(wallet.status,200);assert.equal(wallet.body.balanceCents,0);
+  });
+  await test('only admins can view readiness; healthy test ledger does not mark production ready',async()=>{
+    assert.equal((await api('/admin/launch-audit',{as:buyer})).status,403);
+    const login=await api('/auth/login',{method:'POST',data:{email:'admin@example.invalid',password}});
+    assert.equal(login.status,200);
+    const admin={cookie:login.cookie.split(';')[0],csrf:login.body.csrf};
+    const audit=await api('/admin/launch-audit',{as:admin});
+    assert.equal(audit.status,200,JSON.stringify(audit.body));
+    assert.equal(audit.body.publicLaunchAllowed,false);
+    assert.equal(audit.body.realPayoutsEnabled,false);
+    assert.equal(audit.body.ledger.ok,true);
+    assert.equal(audit.body.stripeTestConfigured,true);
+    assert.ok(audit.body.blockers.some(x=>x.id==='provider_live'));
+    const stripeSummary=await api('/admin/stripe-test/summary',{as:admin});
+    assert.equal(stripeSummary.status,200);
+    assert.ok(stripeSummary.body.webhooks.received>=1);
+    assert.equal(stripeSummary.body.liveMode,false);
+  });
+  await test('webhook status is monotonic; expiry cannot undo paid test event',async()=>{
+    const expired=await webhook(event({id:'evt_expire_after_paid_456',type:'checkout.session.expired',paid:'unpaid'}));
+    assert.equal(expired.status,200);assert.equal(expired.body.accepted,false);
+    assert.equal(app.store.one('SELECT status FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).status,'PAID_TEST');
+  });
+  await test('test checkout rejects unknown missions and does not accept client-chosen prices',async()=>{
+    assert.equal((await api('/missions/nonexistent/test-checkout',{as:buyer,method:'POST',data:{amountCents:1}})).status,404);
+    assert.equal(app.store.one('SELECT amount_cents FROM stripe_test_checkout_sessions WHERE mission_id=?',missionId).amount_cents,9000);
+  });
+}finally{
+  await app.close();fs.rmSync(tmp,{recursive:true,force:true});
+}
