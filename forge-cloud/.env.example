# Example only. Do not commit real values.
NODE_ENV=development
PORT=5200
FORGE_PUBLIC_ORIGIN=http://127.0.0.1:5200
FORGE_BIND_HOST=127.0.0.1
FORGE_DB_PATH=./data/forge.sqlite
# For explicit remote host binding behind a private TLS gateway, set FORGE_ALLOW_REMOTE=YES.
# Production also REQUIRES FORGE_PUBLIC_ORIGIN=https://your-private-host.example
FORGE_ALLOW_REMOTE=NO
# Optional external job sources; no feeds or claims if absent.
FORGE_GREENHOUSE_BOARDS=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# ADMIN CREATION: supply FORGE_ADMIN_EMAIL / FORGE_ADMIN_PASSWORD only
# for the one-time admin:create command; never store them here.
